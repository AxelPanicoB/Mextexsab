# Configuración SMTP para envío de correos
# Copia este archivo como .env y rellena los valores

SMTP_HOST=mail.metexsab.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@metexsab.com
SMTP_PASS=tu_contraseña_aqui

# Destinatario de las notificaciones (default: ventas@metexsab.com)
NOTIFY_EMAIL=ventas@metexsab.com

# Cloudflare Turnstile (anti-bot). Si se omite, la verificación se salta.
TURNSTILE_SECRET=

# Producción: orígenes permitidos para CORS (separados por coma)
# ALLOWED_ORIGIN=https://metexsab.com,https://www.metexsab.com
# NODE_ENV=production
# PORT=4000
