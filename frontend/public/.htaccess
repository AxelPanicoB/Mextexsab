# ══════════════════════════════════════════════════════════════
#  Metexsab — Apache/.htaccess para Neubox (producción)
#  Coloca este archivo en la raíz del directorio donde se aloja
#  el build de Vite (public_html/ o public_html/Mextexsab/)
# ══════════════════════════════════════════════════════════════

Options -Indexes

# ── 1. Una sola dirección: https://www.metexsab.com ─────────
# Sin esto, Google vería metexsab.com y www.metexsab.com como dos sitios iguales. La redirección
# pasa de una vez a https (un solo salto). No afecta a subdominios como nuevo.metexsab.com.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^metexsab\.com$ [NC]
RewriteRule ^ https://www.metexsab.com%{REQUEST_URI} [L,R=301]

# HTTPS forzado
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2. SPA ROUTING (React Router) ────────────────────────────
# Si el sitio está en la raíz del dominio (metexsab.com/):
#   RewriteBase /
#   ...RewriteRule . /index.html [L]
#
# Si está en subdirectorio (metexsab.com/Mextexsab/):
#   RewriteBase /Mextexsab/
#   ...RewriteRule . /Mextexsab/index.html [L]
#
# Ajusta según cómo quedes configurado en Neubox:
RewriteBase /

# ── 2b. Redirecciones desde las direcciones del sitio anterior ─
# Google ya conoce estas URLs (estaban en su sitemap y en sus resultados, con y sin ".html"). Con redirección
# permanente (301) la página nueva hereda lo que ya tenían, en vez de perderlo con un error 404.
RewriteRule ^html/nosotros(\.html)?/?$ /nosotros [R=301,L]
RewriteRule ^html/productos(\.html)?/?$ /productos [R=301,L]
RewriteRule ^html/aplicaciones(\.html)?/?$ /productos [R=301,L]
RewriteRule ^contacto(\.html)?/?$ / [R=301,L]
# /index.html → / (solo cuando lo piden desde fuera; evita un ciclo con el índice del directorio)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]
# /productos.html, /nosotros.html y las páginas por tema también existen como archivo; si alguien las pide
# con ".html", se mandan a la dirección limpia (sin duplicar páginas). Se salvan los archivos de verificación
# de Google y la página 404.
RewriteCond %{THE_REQUEST} \s/(?!google|404|index)([^\s?]+)\.html[\s?]
RewriteRule ^(.+)\.html$ /%1 [R=301,L]

RewriteRule ^index\.html$ - [L]

# Páginas prerenderizadas (las genera "npm run build"): /productos se sirve desde productos.html,
# /saborizantes-para-quesos desde saborizantes-para-quesos.html, etc. Cada una trae ya escritos su
# título, descripción, imagen de vista previa y contenido (WhatsApp y Google no ejecutan JavaScript).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Cualquier otra dirección no existe: se muestra la página 404.html CON código 404 (así Google no la
# toma por una página válida). Todas las páginas reales ya están prerenderizadas arriba.
ErrorDocument 404 /404.html

# ── 3. HOTLINK PROTECTION — imágenes y assets ─────────────────
# Permite: acceso directo (sin referer), el propio dominio,
# y www. Bloquea cualquier otro sitio que intente incrustar
# nuestras imágenes directamente.
# Las imágenes de /img/email/ (el logo de los correos de aviso) quedan fuera de la protección: los
# programas de correo y el webmail las piden desde otras direcciones y se verían rotas.
RewriteCond %{REQUEST_URI} !^/img/email/
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?metexsab\.com [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|mp3)$ - [F,NC,L]

# ── 4. SECURITY HEADERS ──────────────────────────────────────
<IfModule mod_headers.c>
  # Anti-clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Previene MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Convierte a https cualquier recurso que se pida por http (regla que ya traía el sitio anterior)
  Header always set Content-Security-Policy "upgrade-insecure-requests;"

  # Referrer: solo origen al cruzar dominios
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # No indexar assets directos
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_URI} =~ m#^/api/#"

  # Permissions Policy — desactiva APIs innecesarias
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HSTS — solo activar cuando SSL esté confirmado en Neubox
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── 5. CACHE CONTROL — assets con hash (Vite los nombra así) ──
<IfModule mod_expires.c>
  ExpiresActive On

  # JS/CSS con hash en nombre → inmutable (Vite genera hashes)
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes y fuentes → 1 mes
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf)$">
    ExpiresDefault "access plus 1 month"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML → sin cache (siempre fresco para updates del SPA)
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ── 6. COMPRESIÓN GZIP ────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ── 7. BLOQUEO DE BOTS AGRESIVOS ─────────────────────────────
# Estos user-agents corresponden a scrapers conocidos
RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|BLEXBot|PetalBot) [NC]
RewriteRule ^ - [F,L]

# ── 8. BLOQUEAR ACCESO DIRECTO A ARCHIVOS SENSIBLES ──────────
<FilesMatch "(^\.env|\.env\.|\.git|composer\.(json|lock)|package\.json|package-lock\.json)">
  Order allow,deny
  Deny from all
</FilesMatch>
